// Lumen.rc - Windows resource: embeds icon + version info into .exe
#include <windows.h>
IDI_ICON1 ICON "icons/lumen.ico"
VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,0,0,0
  PRODUCTVERSION  1,0,0,0
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Lumen Browser Project\0"
      VALUE "FileDescription",  "Lumen - Fast, Private, Modern Browser\0"
      VALUE "FileVersion",      "1.0.0.0\0"
      VALUE "ProductName",      "Lumen Browser\0"
      VALUE "ProductVersion",   "1.0.0.0\0"
      VALUE "OriginalFilename", "Lumen.exe\0"
      VALUE "LegalCopyright",   "MIT License\0"
      VALUE "Comments",         "Built on Chromium 120 / Qt 6.6 / C++20\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN VALUE "Translation", 0x409, 1200 END
END
